OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MONGODB_URI=
MONGODB_DATABASE=analista_de_vagas
PERSISTENCE_BACKEND=sqlite
PUBLIC_BASE_URL=
CORS_ALLOW_ORIGINS=*
APP_NAME=Analista de Vagas API
APP_VERSION=1.0.0

PASSWORD_RESET_EXPIRATION_MINUTES=30
PASSWORD_RESET_EXPOSE_TOKEN=false
CURRENT_TERMS_VERSION=1.0
CURRENT_PRIVACY_VERSION=1.0

# Billing Stripe (opcional em teste/local; obrigatorio para checkout e webhook)
# Sem essas chaves, o plano Free (5 /processar por mes UTC) continua funcionando.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ESSENCIAL=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=

# Object storage Cloudflare R2 (S3-compativel).
# Em local/dev, se essas vars estiverem vazias, a API grava em disco (STORAGE_DIR).
# Em producao (ENV=production ou ENVIRONMENT=production) o boot falha sem elas.
# Bucket deve permanecer privado (sem ACL publica).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_SIGNED_URL_EXPIRES=900
